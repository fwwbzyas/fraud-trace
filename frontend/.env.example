# Copy to .env.local. VITE_* values are public and are embedded during build.
# Frontend-only demo; stored UI preferences override this default.
VITE_DEMO_MODE=true
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:8080

# Optional Dify widget, disabled by default. Never put a private API key here.
VITE_DIFY_ENABLED=false
VITE_DIFY_BASE_URL=
VITE_DIFY_EMBED_TOKEN=
